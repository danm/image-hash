{
  "name": "image-hash",
  "version": "8.0.1",
  "description": "Create a hash from an image",
  "type": "module",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    }
  },
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "files": [
    "lib"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@10.34.9",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/danm/image-hash.git"
  },
  "keywords": [
    "phash",
    "hash",
    "image hash",
    "perceptual hash"
  ],
  "author": "Daniel Morrison <daniel.morrison@bbc.co.uk>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/danm/image-hash/issues"
  },
  "homepage": "https://github.com/danm/image-hash#readme",
  "dependencies": {
    "@cwasm/webp": "^0.1.5",
    "file-type": "^22.2.0",
    "jpeg-js": "^0.4.4",
    "pngjs": "^7.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/node": "^22.20.5",
    "@types/pngjs": "^6.0.5",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  }
}
